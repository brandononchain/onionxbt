# OnionXBT Environment Configuration

# ===================
# AI Provider
# ===================
AGENT_PROVIDER=anthropic  # or 'openai'
AGENT_MODEL=claude-sonnet-4-20250514
AGENT_API_KEY=your_api_key_here

# ===================
# Bitcoin (On-chain)
# ===================
BTC_NETWORK=mainnet  # or 'testnet'
BTC_XPUB=your_xpub_here  # HD wallet extended public key

# ===================
# Lightning Network
# ===================
LN_PROVIDER=lnbits  # or 'btcpay' or 'lnd'
LN_ENDPOINT=https://your-lnbits-instance.com
LN_API_KEY=your_lnbits_api_key

# BTCPay (if using BTCPay)
# BTCPAY_STORE_ID=your_store_id

# LND (if using LND directly)
# LND_MACAROON=your_admin_macaroon_hex

# ===================
# X/Twitter Bot
# ===================
X_APP_KEY=your_twitter_app_key
X_APP_SECRET=your_twitter_app_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_SECRET=your_access_secret

# ===================
# Database
# ===================
DATABASE_PATH=./data/onionxbt.db

# ===================
# Tor (optional)
# ===================
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=

# ===================
# Server
# ===================
PORT=3000
NODE_ENV=development
